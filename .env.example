# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID_DEV=your_dev_guild_id_here

# PostgreSQL Database Configuration (All-in-One Container)
DATABASE_URL=postgresql://musicbot:password@localhost:5432/musicbot_db
POSTGRES_USER=musicbot
POSTGRES_PASSWORD=password
POSTGRES_DB=musicbot_db

# Redis Configuration (All-in-One Container)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Web Server Configuration
PORT=3000
DASHBOARD_BASE_URL=http://localhost:3000
SESSION_SECRET=your_session_secret_here_change_in_production

# Bot Configuration
OWNER_DISCORD_IDS=123456789,987654321
DEFAULT_VOLUME=0.5
MAX_PLAYLIST_ITEMS=100
IDLE_DISCONNECT_SECONDS=300

# Node Environment
NODE_ENV=development
