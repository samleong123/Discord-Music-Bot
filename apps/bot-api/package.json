{
  "name": "bot-api",
  "version": "1.0.0",
  "description": "Discord music bot with web API",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "node --loader ts-node/esm src/main.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/main.js",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@noble/ciphers": "^1.0.0",
    "@prisma/client": "^5.7.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "prism-media": "^1.3.4",
    "redis": "^4.6.13",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/node": "^22.0.0",
    "prisma": "^5.7.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
